---
import BaseLayout from "../layouts/BaseLayout.astro";
import TechMetaStrip from "../components/TechMetaStrip.astro";

const notFoundMeta = [
  { label: "Status", value: "404 / Missing", accent: "danger" as const },
  { label: "Fallback", value: "Home / Tags / Search" },
];
---

<BaseLayout title="页面不存在">
  <section class="page-header shell-card">
    <div class="page-header__body">
      <p class="eyebrow">404 // BROKEN PATH</p>
      <h1>页面不存在</h1>
      <p>这个地址可能已经变更，或者暂时还没有对应内容。你可以回首页、按标签继续找，或者直接搜索。</p>
      <div class="hero-actions">
        <a class="hero-action is-primary" href="/">返回首页</a>
        <a class="hero-action" href="/tags/">查看标签</a>
        <a class="hero-action" href="/search/">站内搜索</a>
      </div>
    </div>

    <div class="page-header__side">
      <TechMetaStrip items={notFoundMeta} columns={2} />
    </div>
  </section>
</BaseLayout>

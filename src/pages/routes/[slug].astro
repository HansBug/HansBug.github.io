---
import { render } from "astro:content";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import MermaidRenderer from "../../components/MermaidRenderer.astro";
import PostCard from "../../components/PostCard.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import TagChip from "../../components/TagChip.astro";
import TechMetaStrip from "../../components/TechMetaStrip.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getAllBlogPosts,
  getAllRoutes,
  getRoutePosts,
  tagToSlug,
} from "../../utils/content";
import { hasMathSyntax, hasMermaidFence } from "../../utils/markdownFeatures";

const allPosts = await getAllBlogPosts();

export async function getStaticPaths() {
  const routes = await getAllRoutes();

  return routes.map((route) => ({
    params: { slug: route.id },
    props: { route },
  }));
}

const { route } = Astro.props;
const { Content } = await render(route);
const markdownBody = route.body ?? "";
const hasMermaid = hasMermaidFence(markdownBody);
const hasMath = hasMathSyntax(markdownBody);
const posts = getRoutePosts(route, allPosts);
const routeMeta = [
  { label: "Stage", value: route.data.stage },
  { label: "Time", value: route.data.estimatedTime, accent: "accent" as const },
  { label: "Posts", value: `${posts.length} 篇` },
  { label: "Mode", value: "Curated Reading" },
];
---

<BaseLayout title={route.data.title} description={route.data.summary} includeKatex={hasMath}>
  <div class="page-grid">
    <Breadcrumbs
      items={[
        { label: "首页", href: "/" },
        { label: "路线", href: "/routes/" },
        { label: route.data.title },
      ]}
    />

    <section class="article-shell shell-card">
      <header class="article-header">
        <div class="entry-rail">
          <p class="entry-rail__kicker">READING ROUTE</p>
          <span class="entry-rail__status">{route.data.stage}</span>
        </div>
        <h1>{route.data.title}</h1>
        <p class="article-intro">{route.data.summary}</p>
        <TechMetaStrip items={routeMeta} columns={4} />
        <div class="tag-row">
          {route.data.tags.map((tag) => <TagChip tag={tag} href={`/tags/${tagToSlug(tag)}/`} />)}
        </div>
      </header>
      <div class="article-content shell-card">
        <Content />
        {hasMermaid && <MermaidRenderer />}
      </div>
    </section>

    <section>
      <SectionHeading
        eyebrow="Recommended Files"
        title="按这个顺序继续看"
        description="这里的文章被组织成一个更适合长期复用的阅读序列。"
        serial="R-02"
      />
      <div class="grid-two">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  </div>
</BaseLayout>

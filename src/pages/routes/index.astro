---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RouteCard from "../../components/RouteCard.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import TechMetaStrip from "../../components/TechMetaStrip.astro";
import { getAllRoutes } from "../../utils/content";

const routes = await getAllRoutes();
const routeMeta = [
  { label: "Routes", value: `${routes.length} 条路线`, accent: "accent" as const },
  { label: "Purpose", value: "把文章串成路径" },
  { label: "Priority", value: "读法优先于热度" },
  { label: "State", value: routes.length > 0 ? "已录入路线" : "待补内容" },
];
---

<BaseLayout title="路线">
  <section class="page-header shell-card">
    <div class="page-header__body">
      <p class="eyebrow">ROUTE INDEX</p>
      <h1>阅读路线</h1>
      <p>
        这里的路线不是教程目录，而是“如何进入一个问题域”的指引系统。你可以把它理解为带推荐顺序和关键问题的专题入口。
      </p>
    </div>

    <div class="page-header__side">
      <TechMetaStrip items={routeMeta} columns={2} />
    </div>
  </section>

  {
    routes.length > 0 ? (
      <section>
        <SectionHeading
          eyebrow="Route Board"
          title="按目标选择，而不是按热度选择"
          description="如果你想补基础，先看工程基础；如果你正在做 AI 应用，先看评测路线；如果你想搭自己的技术博客，直接看写作与沉淀路线。"
          serial="R-01"
        />
        <div class="grid-three">
          {routes.map((route) => <RouteCard route={route} />)}
        </div>
      </section>
    ) : (
      <section class="empty-state shell-card">
        <h2>路线系统还在等第一批新文</h2>
        <p>
          我希望路线页承担“阅读指引”而不是“旧文目录”，所以会等新内容的结构稳定后再逐步补齐。
        </p>
      </section>
    )
  }
</BaseLayout>

---
import SearchPanel from "../components/SearchPanel.astro";
import TechMetaStrip from "../components/TechMetaStrip.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAllBlogPosts, getAllProjects, getAllRoutes } from "../utils/content";
import { formatDate } from "../utils/date";

const [posts, routes, projects] = await Promise.all([
  getAllBlogPosts(),
  getAllRoutes(),
  getAllProjects(),
]);

const items = [
  ...posts.map((post) => ({
    title: post.data.title,
    description: post.data.description,
    url: `/blog/${post.id}/`,
    type: "博客文章",
    tags: post.data.tags,
    meta: formatDate(post.data.pubDate),
  })),
  ...routes.map((route) => ({
    title: route.data.title,
    description: route.data.summary,
    url: `/routes/${route.id}/`,
    type: "阅读路线",
    tags: route.data.tags,
    meta: `${route.data.stage} · ${route.data.estimatedTime}`,
  })),
  ...projects.map((project) => ({
    title: project.data.title,
    description: project.data.summary,
    url: `/projects/${project.id}/`,
    type: "项目卡片",
    tags: project.data.stack,
    meta: project.data.status,
  })),
];
const searchMeta = [
  { label: "Index Size", value: `${items.length} 条记录`, accent: "accent" as const },
  { label: "Scope", value: "文章 / 路线 / 项目" },
  { label: "Mode", value: "前端即时检索" },
  { label: "Fallback", value: "可转标签页继续找", accent: "amber" as const },
];
---

<BaseLayout title="搜索">
  <div class="page-grid">
    <section class="page-header shell-card">
      <div class="page-header__body">
        <p class="eyebrow">SEARCH INDEX</p>
        <h1>站内搜索</h1>
        <p>可以搜索标题、描述、标签和项目技术栈，适合快速定位文章、路线和项目页。</p>
      </div>

      <div class="page-header__side">
        <TechMetaStrip items={searchMeta} columns={2} />
      </div>
    </section>

    {
      items.length > 0 ? (
        <SearchPanel items={items} />
      ) : (
        <section class="empty-state shell-card">
          <h2>暂时还没有可搜索的新站内容</h2>
          <p>
            新站内容开始发布后，搜索结果会直接显示在这里；历史文章可以先从旧站归档页进入。
          </p>
        </section>
      )
    }
  </div>
</BaseLayout>

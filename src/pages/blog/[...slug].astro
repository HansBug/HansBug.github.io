---
import { render } from "astro:content";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import MermaidRenderer from "../../components/MermaidRenderer.astro";
import PostCard from "../../components/PostCard.astro";
import RouteCard from "../../components/RouteCard.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import TagChip from "../../components/TagChip.astro";
import TechMetaStrip from "../../components/TechMetaStrip.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  calculateReadingMinutes,
  getAllBlogPosts,
  getAllRoutes,
  getPrevNextPosts,
  getRelatedPosts,
  tagToSlug,
} from "../../utils/content";
import { formatDate } from "../../utils/date";
import { hasMathSyntax, hasMermaidFence } from "../../utils/markdownFeatures";

const allPosts = await getAllBlogPosts();
const allRoutes = await getAllRoutes();

export async function getStaticPaths() {
  const posts = await getAllBlogPosts();

  return posts.map((post) => {
    const { newer, older } = getPrevNextPosts(post, posts);
    return {
      params: { slug: post.id },
      props: { post, newer, older },
    };
  });
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const markdownBody = post.body ?? "";
const hasMermaid = hasMermaidFence(markdownBody);
const hasMath = hasMathSyntax(markdownBody);
const relatedPosts = getRelatedPosts(post, allPosts);
const readingMinutes = calculateReadingMinutes(post.body ?? "");
const relatedRoutes = allRoutes
  .filter(
    (route) =>
      post.data.routeSlugs.includes(route.id) ||
      route.data.tags.some((tag) => post.data.tags.includes(tag)),
  )
  .slice(0, 3);
const postMeta = [
  { label: "Published", value: formatDate(post.data.pubDate) },
  {
    label: "Updated",
    value: post.data.updatedDate ? formatDate(post.data.updatedDate) : "初稿版本",
    accent: post.data.updatedDate ? "accent" as const : "muted" as const,
  },
  { label: "Level", value: post.data.difficulty },
  { label: "Read Time", value: `${readingMinutes} 分钟` },
];
---

<BaseLayout title={post.data.title} description={post.data.description} includeKatex={hasMath}>
  <div class="page-grid">
    <Breadcrumbs
      items={[
        { label: "首页", href: "/" },
        { label: "博客", href: "/blog/" },
        { label: post.data.title },
      ]}
    />

    <div class="article-layout">
      <article class="article-shell shell-card">
        <header class="article-header">
          <div class="entry-rail">
            <p class="entry-rail__kicker">{post.data.series ?? "TECH NOTE"}</p>
            <span class="entry-rail__status">{post.data.pinned ? "PINNED" : post.data.difficulty}</span>
          </div>
          <h1>{post.data.title}</h1>
          <p class="article-intro">{post.data.description}</p>
          <TechMetaStrip items={postMeta} columns={4} />
          <div class="tag-row">
            {post.data.tags.map((tag) => <TagChip tag={tag} href={`/tags/${tagToSlug(tag)}/`} />)}
          </div>
        </header>

        <div class="article-content shell-card">
          <Content />
          {hasMermaid && <MermaidRenderer />}
        </div>
      </article>

      <aside class="article-aside">
        <TableOfContents headings={headings} />

        <section class="shell-card info-panel">
          <p class="toc-title">Continue Reading</p>
          <ul class="panel-list">
            <li><a href="/routes/">按路线查看体系化内容</a></li>
            <li><a href="/tags/">按标签查看相近主题</a></li>
            <li><a href="/contact/">有问题或勘误可直接联系</a></li>
          </ul>
        </section>
      </aside>
    </div>

    {(newer || older) && (
      <section>
        <SectionHeading
          eyebrow="Adjacent Files"
          title="继续往下看"
          description="如果你是连续阅读本站内容，可以从相邻文章继续推进。"
          serial="P-01"
        />
        <div class="grid-two">
          {newer && <PostCard post={newer} compact />}
          {older && <PostCard post={older} compact />}
        </div>
      </section>
    )}

    {relatedRoutes.length > 0 && (
      <section>
        <SectionHeading
          eyebrow="Related Routes"
          title="这篇文章属于这些更大的主题"
          description="如果你不想只停在单篇文章，建议直接进入对应路线继续看。"
          serial="P-02"
        />
        <div class="grid-three">
          {relatedRoutes.map((route) => <RouteCard route={route} />)}
        </div>
      </section>
    )}

    {relatedPosts.length > 0 && (
      <section>
        <SectionHeading
          eyebrow="Related Files"
          title="继续读这些内容"
          description="根据共享标签给出关联文章，帮助你把零散问题串成一条线。"
          serial="P-03"
        />
        <div class="grid-three">
          {relatedPosts.map((relatedPost) => <PostCard post={relatedPost} compact />)}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import TechMetaStrip from "../../components/TechMetaStrip.astro";
import { siteConfig } from "../../config/site";
import { getAllBlogPosts, groupPostsByYear } from "../../utils/content";
import { formatDate } from "../../utils/date";

const posts = await getAllBlogPosts();
const archive = groupPostsByYear(posts);
const archiveMeta = [
  { label: "Years", value: `${archive.length} 个年份` },
  { label: "Posts", value: `${posts.length} 篇文章`, accent: "accent" as const },
  { label: "View", value: "按时间回看变化" },
  { label: "Fallback", value: "旧文请走旧站归档", accent: "amber" as const },
];
---

<BaseLayout title="归档">
  <section class="page-header shell-card">
    <div class="page-header__body">
      <p class="eyebrow">TIMELINE INDEX</p>
      <h1>时间归档</h1>
      <p>如果你习惯按时间线回看博客演化，可以从这里进入。归档更适合观察关注点如何逐渐收敛。</p>
    </div>

    <div class="page-header__side">
      <TechMetaStrip items={archiveMeta} columns={2} />
    </div>
  </section>

  <div class="page-grid">
    {
      archive.length > 0 ? (
        archive.map((entry) => (
          <section class="archive-year shell-card">
            <SectionHeading
              eyebrow="Year"
              title={entry.year}
              description={`这一年共整理出 ${entry.posts.length} 篇文章。`}
              serial="A-01"
            />
            <ul class="archive-list">
              {entry.posts.map((post) => (
                <li>
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                  <span>{formatDate(post.data.pubDate)}</span>
                </li>
              ))}
            </ul>
          </section>
        ))
      ) : (
        <section class="empty-state shell-card">
          <h2>新站归档还是空白</h2>
          <p>
            历史文章可以先从旧站归档页进入；新站文章发布后，这里会按年份整理时间线。
          </p>
          <div class="hero-actions">
            <a class="hero-action is-primary" href={siteConfig.oldBlogArchivePath}>查看旧站归档</a>
            <a class="hero-action" href="/blog/">返回博客页</a>
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

---
import { render } from "astro:content";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import MermaidRenderer from "../../components/MermaidRenderer.astro";
import TechMetaStrip from "../../components/TechMetaStrip.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllProjects } from "../../utils/content";

export async function getStaticPaths() {
  const projects = await getAllProjects();

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const hasMermaid = (project.body ?? "").includes("```mermaid");
const projectMeta = [
  { label: "State", value: project.data.status },
  { label: "Stack", value: project.data.stack.join(" / "), accent: "accent" as const },
  { label: "Repo", value: project.data.repoUrl ? "Available" : "Private / Pending" },
  { label: "Demo", value: project.data.demoUrl ? "Available" : "Not Public" },
];
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <div class="page-grid">
    <Breadcrumbs
      items={[
        { label: "首页", href: "/" },
        { label: "项目", href: "/projects/" },
        { label: project.data.title },
      ]}
    />

    <section class="article-shell shell-card">
      <header class="article-header">
        <div class="entry-rail">
          <p class="entry-rail__kicker">PROJECT DOSSIER</p>
          <span class="entry-rail__status">{project.data.status}</span>
        </div>
        <h1>{project.data.title}</h1>
        <p class="article-intro">{project.data.summary}</p>
        <TechMetaStrip items={projectMeta} columns={4} />
        <div class="hero-actions">
          {project.data.repoUrl && (
            <a class="hero-action is-primary" href={project.data.repoUrl} target="_blank" rel="noreferrer">
              查看仓库
            </a>
          )}
          {project.data.demoUrl && (
            <a class="hero-action" href={project.data.demoUrl} target="_blank" rel="noreferrer">
              打开演示
            </a>
          )}
        </div>
      </header>
      <div class="article-content shell-card">
        <Content />
        {hasMermaid && <MermaidRenderer />}
      </div>
    </section>
  </div>
</BaseLayout>

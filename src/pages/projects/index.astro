---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import TechMetaStrip from "../../components/TechMetaStrip.astro";
import { getAllProjects } from "../../utils/content";

const projects = await getAllProjects();
const projectMeta = [
  { label: "Projects", value: `${projects.length} 个项目`, accent: "accent" as const },
  { label: "Scope", value: "长期实践与实验档案" },
  { label: "Sort", value: "精选优先 / order 次序" },
  { label: "Status", value: projects.length > 0 ? "已录入条目" : "待开放" },
];
---

<BaseLayout title="项目">
  <section class="page-header shell-card">
    <div class="page-header__body">
      <p class="eyebrow">PROJECT INDEX</p>
      <h1>项目与实验</h1>
      <p>这里集中查看那些比单篇文章更长、比路线更具体的项目、实验和持续实践。</p>
    </div>

    <div class="page-header__side">
      <TechMetaStrip items={projectMeta} columns={2} />
    </div>
  </section>

  {
    projects.length > 0 ? (
      <section>
        <SectionHeading
          eyebrow="Project Board"
          title="当前公开的项目卡片"
          description="每张卡片都会链接到对应说明页，方便继续查看背景、状态和细节。"
          serial="J-01"
        />
        <div class="grid-three">
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      </section>
    ) : (
      <section class="empty-state shell-card">
        <h2>项目页骨架已经预留，但还没有录入内容</h2>
        <p>项目条目录入后，这里会显示对应的项目档案和说明页。</p>
      </section>
    )
  }
</BaseLayout>

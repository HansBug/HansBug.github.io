---
import BaseLayout from "../layouts/BaseLayout.astro";
import TerminalQuoteHero from "../components/TerminalQuoteHero.astro";
import PostCard from "../components/PostCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TechMetaStrip from "../components/TechMetaStrip.astro";
import { siteConfig } from "../config/site";
import { heroQuotes } from "../data/heroQuotes";
import { getAllBlogPosts } from "../utils/content";
import { formatDate } from "../utils/date";

const posts = await getAllBlogPosts();
const recentPosts = posts.slice(0, 6);
const latestPost = posts[0];
const latestUpdate = latestPost
  ? formatDate(latestPost.data.updatedDate ?? latestPost.data.pubDate)
  : "待录入";
const heroMeta = [
  { label: "Latest Update", value: latestUpdate, accent: "accent" as const },
  { label: "Blog Entries", value: `${posts.length} 篇新站文章` },
  { label: "Legacy Archive", value: "315 篇旧站索引", accent: "amber" as const },
  { label: "Contact", value: siteConfig.email },
];
---

<BaseLayout>
  <div class="page-grid home-page">
    <section class="home-hero shell-card">
      <div class="home-hero__copy">
        <p class="eyebrow">HB-NODE // TERMINAL FEED</p>
        <TerminalQuoteHero quotes={heroQuotes} />
        <p class="home-hero__lead">
          从这里进入新文章、标签索引、旧站归档、RSS 和联系入口。
        </p>
        <div class="hero-actions">
          <a class="hero-action is-primary" href="/blog/">进入博客</a>
          <a class="hero-action" href="/tags/">浏览标签</a>
          <a class="hero-action" href={siteConfig.rssUrl}>订阅 RSS</a>
          <a class="hero-action" href="/contact/">联系 HansBug</a>
        </div>
      </div>

      <div class="home-hero__visual">
        <article class="hero-dossier shell-card shell-card--dense">
          <div class="entry-rail">
            <p class="entry-rail__kicker">LIVE INDEX</p>
            <span class="entry-rail__status">READY</span>
          </div>
          <p class="hero-dossier__summary">
            新内容从博客页进入，旧内容从归档页回看；标签、时间线和搜索页可以把零散问题重新串起来。
          </p>
          <TechMetaStrip items={heroMeta} columns={2} compact />
        </article>
      </div>
    </section>

    <section class="home-feed shell-card">
      <SectionHeading
        eyebrow="Live Feed"
        title={posts.length > 0 ? "最近更新" : "还没有新文章"}
        description={
          posts.length > 0
            ? "最新发布的文章会按时间列在这里。"
            : "第一批文章发布后，这里会直接显示最近更新。"
        }
        serial="S-01"
      />

      {
        recentPosts.length > 0 ? (
          <div class="grid-two">
            {recentPosts.map((post) => <PostCard post={post} compact />)}
          </div>
        ) : (
          <section class="home-empty">
            <span class="home-empty__count">0 篇</span>
            <h2>第一批文章还在整理中</h2>
            <p>文章发布后，这里会按时间列出最近更新。</p>
            <div class="hero-actions">
              <a class="hero-action is-primary" href="/blog/">打开博客页</a>
              <a class="hero-action" href="/tags/">看标签体系</a>
              <a class="hero-action" href={siteConfig.rssUrl}>查看 RSS</a>
            </div>
          </section>
        )
      }
    </section>
  </div>
</BaseLayout>

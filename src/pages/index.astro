---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeDeskPet from "../components/HomeDeskPet.vue";
import TerminalQuoteHero from "../components/TerminalQuoteHero.astro";
import PostCard from "../components/PostCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { siteConfig } from "../config/site";
import bangdreamDeskPetPool from "../data/bangdreamDeskPetPool.json";
import { heroQuotes } from "../data/heroQuotes";
import { getAllBlogPosts } from "../utils/content";

const posts = await getAllBlogPosts();
const recentPosts = posts.slice(0, 6);
const latestPost = posts[0];
const latestSignalDate = latestPost ? latestPost.data.updatedDate ?? latestPost.data.pubDate : undefined;
const latestDigits = latestSignalDate
  ? `${latestSignalDate.getFullYear().toString().slice(-2)}.${String(latestSignalDate.getMonth() + 1).padStart(2, "0")}.${String(latestSignalDate.getDate()).padStart(2, "0")}`
  : "--.--.--";
const latestStatus = latestSignalDate ? "SYNCED" : "PENDING";
const entryDigits = String(posts.length).padStart(4, "0");
const legacyDigits = "0315";
---

<BaseLayout>
  <div class="page-grid home-page">
    <section class="home-hero shell-card">
      <div class="home-hero__copy">
        <p class="eyebrow">HB-NODE // TERMINAL FEED</p>
        <TerminalQuoteHero quotes={heroQuotes} />
        <p class="home-hero__lead">
          从这里进入新文章、标签索引、旧站归档、RSS 和联系入口。
        </p>
        <div class="hero-actions">
          <a class="hero-action is-primary" href="/blog/">进入博客</a>
          <a class="hero-action" href="/tags/">浏览标签</a>
          <a class="hero-action" href={siteConfig.rssUrl}>订阅 RSS</a>
          <a class="hero-action" href="/contact/">联系 HansBug</a>
        </div>
      </div>

      <div class="home-hero__visual">
        <article class="hero-hud shell-card shell-card--dense">
          <header class="hero-hud__header">
            <div>
              <p class="eyebrow">LIVE INDEX</p>
              <h2 class="hero-hud__title">READY</h2>
            </div>
            <div class="hero-hud__bars" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
              <span></span>
            </div>
          </header>

          <p class="hero-hud__summary">
            博客、标签、归档和搜索页已经联通，可以直接从熟悉的入口进入。
          </p>

          <div class="hero-hud__grid">
            <article class="hero-hud-card is-accent">
              <span class="hero-hud-card__label">Latest Sync</span>
              <strong class="tech-digits">{latestDigits}</strong>
              <p>{latestStatus}</p>
            </article>

            <article class="hero-hud-card">
              <span class="hero-hud-card__label">Blog Entries</span>
              <strong class="tech-digits">{entryDigits}</strong>
              <p>new articles</p>
            </article>

            <article class="hero-hud-card is-amber">
              <span class="hero-hud-card__label">Legacy Index</span>
              <strong class="tech-digits">{legacyDigits}</strong>
              <p>archived posts</p>
            </article>

            <article class="hero-hud-card">
              <span class="hero-hud-card__label">Contact Port</span>
              <strong class="hero-hud-card__value">{siteConfig.email}</strong>
              <p>mail signal</p>
            </article>
          </div>

          <div class="hero-hud__footer">
            <span>RSS / TAGS / ARCHIVE / LEGACY</span>
            <span class="tech-digits tech-digits--mini">01</span>
          </div>
        </article>
      </div>
    </section>

    <section class="home-feed shell-card">
      <SectionHeading
        eyebrow="Live Feed"
        title={posts.length > 0 ? "最近更新" : "还没有新文章"}
        description={
          posts.length > 0
            ? "最新发布的文章会按时间列在这里。"
            : "第一批文章发布后，这里会直接显示最近更新。"
        }
        serial="S-01"
      />

      {
        recentPosts.length > 0 ? (
          <div class="grid-two">
            {recentPosts.map((post) => <PostCard post={post} compact />)}
          </div>
        ) : (
          <section class="home-empty">
            <span class="home-empty__count">0 篇</span>
            <h2>第一批文章还在整理中</h2>
            <p>文章发布后，这里会按时间列出最近更新。</p>
            <div class="hero-actions">
              <a class="hero-action is-primary" href="/blog/">打开博客页</a>
              <a class="hero-action" href="/tags/">看标签体系</a>
              <a class="hero-action" href={siteConfig.rssUrl}>查看 RSS</a>
            </div>
          </section>
        )
      }
    </section>
  </div>
  <HomeDeskPet client:load pool={bangdreamDeskPetPool} />
</BaseLayout>

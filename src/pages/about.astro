---
import BaseLayout from "../layouts/BaseLayout.astro";
import TechMetaStrip from "../components/TechMetaStrip.astro";
import { siteConfig } from "../config/site";

const aboutMeta = [
  { label: "Position", value: "中文个人技术博客" },
  { label: "Role", value: "新写作与知识索引", accent: "accent" as const },
  { label: "Legacy", value: "旧站独立归档" },
  { label: "Contact", value: siteConfig.email, accent: "amber" as const },
];
---

<BaseLayout title="关于">
  <div class="page-grid">
    <section class="page-header shell-card">
      <div class="page-header__body">
        <p class="eyebrow">ABOUT NODE</p>
        <h1>关于 HansBug</h1>
        <p>
          这里集中查看 HansBug 的新文章、项目记录和知识索引；历史内容则由独立的旧站归档页统一整理。
        </p>
      </div>

      <div class="page-header__side">
        <TechMetaStrip items={aboutMeta} columns={2} />
      </div>
    </section>

    <section class="grid-two">
      <article class="info-panel shell-card">
        <h2>在这里可以看到什么</h2>
        <ul class="info-panel__list">
          <li>按标签、路线和项目组织的新文章与技术记录。</li>
          <li>适合长期检索和复用的主题索引，而不是一次性展示页。</li>
          <li>按时间更新的首页入口，以及可回溯的归档与搜索页。</li>
        </ul>
      </article>

      <article class="info-panel shell-card">
        <h2>旧内容怎么处理</h2>
        <ul class="info-panel__list">
          <li>旧博客正文保留在博客园原站，不与新站文章混排。</li>
          <li>旧站归档页提供主题梳理、精选链接、发布时间和阅读量。</li>
          <li>值得继续追踪的旧主题，会以重写后的新文章形式重新出现。</li>
        </ul>
        <a class="inline-link" href={siteConfig.oldBlogArchivePath}>查看旧站归档</a>
      </article>
    </section>

    <section class="grid-two">
      <article class="cta-panel shell-card">
        <h2>旧博客原站</h2>
        <p>
          如果你需要直接访问博客园旧站，可以打开
          <a class="inline-link" href={siteConfig.oldBlogUrl} target="_blank" rel="noreferrer">
            {siteConfig.oldBlogUrl}
          </a>
          。
        </p>
      </article>

      <article class="cta-panel shell-card">
        <h2>联系入口</h2>
        <p>
          如果你想交流、合作、勘误或只是单纯想打个招呼，可以直接发邮件到
          <a class="inline-link" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>。
        </p>
      </article>
    </section>
  </div>
</BaseLayout>

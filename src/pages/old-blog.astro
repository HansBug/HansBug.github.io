---
import BaseLayout from "../layouts/BaseLayout.astro";
import OldBlogExplorer from "../components/OldBlogExplorer.vue";
import SectionHeading from "../components/SectionHeading.astro";
import TechMetaStrip from "../components/TechMetaStrip.astro";
import { oldBlogArchive } from "../data/oldBlogArchive";
import { oldBlogCatalog } from "../data/oldBlogCatalog";

const numberFormatter = new Intl.NumberFormat("zh-CN");
const oldBlogMeta = [
  { label: "Period", value: oldBlogArchive.period },
  { label: "Posts", value: `${oldBlogArchive.totalPosts} 篇`, accent: "accent" as const },
  { label: "Comments", value: `${oldBlogArchive.totalComments} 条` },
  { label: "Views", value: oldBlogArchive.totalViewsText },
  { label: "Followers", value: `${oldBlogCatalog.profile.followers} 粉丝` },
  { label: "Active Months", value: `${oldBlogCatalog.archives.length} 个活跃月份`, accent: "amber" as const },
];
---

<BaseLayout title="旧站归档">
  <div class="page-grid">
    <section class="page-header shell-card">
      <div class="page-header__body">
        <p class="eyebrow">LEGACY ARCHIVE</p>
        <h1>博客园旧站归档说明</h1>
        <p>
          这里整理的是博客园旧站的历史档案：可以查看内容范围、代表性入口，以及带发布时间和阅读量的旧文索引。
        </p>
      </div>

      <div class="page-header__side">
        <TechMetaStrip items={oldBlogMeta} columns={2} />
      </div>
    </section>

    <section>
      <SectionHeading
        eyebrow="Legacy Phase"
        title="旧站大致经历了三个阶段"
        description="这部分是对旧博客结构的梳理，不是正文迁移。目的是帮助读者判断哪些入口现在还值得点开。"
        serial="L-01"
      />
      <div class="grid-three">
        {
          oldBlogArchive.summary.map((item) => (
            <article class="info-panel shell-card">
              <p class="eyebrow">{item.title}</p>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section>
      <SectionHeading
        eyebrow="Main Tracks"
        title="旧站里比较成体系的内容方向"
        description="分类数量来自博客园旧站公开侧栏数据。这里展示的是更能代表旧站结构的几条主线。"
        serial="L-02"
      />
      <div class="grid-three">
        {
          oldBlogArchive.categoryHighlights.map((item) => (
            <article class="info-panel shell-card">
              <p class="eyebrow">{item.name}</p>
              <h3>{item.name}</h3>
              <p>{item.description}</p>
              <div class="tag-row">
                <span class="tag-chip is-blue"><span>{item.count} 篇</span></span>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section>
      <SectionHeading
        eyebrow="Legacy Catalog"
        title="旧站的 315 篇文章，现在可以直接检索、看趋势、随时跳转"
        description="这里维护的是博客园旧站的完整文章索引。你可以按标题、年份、旧站分类和归纳方向查询，也可以直接从年度趋势和检索区定位旧文。"
        serial="L-03"
      />
      <OldBlogExplorer client:load catalog={oldBlogCatalog} />
    </section>

    <section>
      <article class="info-panel shell-card">
        <SectionHeading
          eyebrow="Archive Closure"
          title="这部分历史内容到这里为止"
          description="以下两篇可以帮助理解旧站在整条写作时间线中的位置。"
          serial="L-04"
        />
        <div class="panel-list">
          {
            oldBlogArchive.closingPosts.map((post) => (
              <div class="shell-card shell-card--dense">
                <p class="eyebrow">{post.topic}</p>
                <h3 class="oldblog-linked-title">
                  <a href={post.url} target="_blank" rel="noreferrer">{post.title}</a>
                </h3>
                <p>{post.note}</p>
                <div class="tag-row">
                  <span class="tag-chip is-slate"><span>发布于 {post.date}</span></span>
                  <span class="tag-chip is-blue"><span>阅读 {numberFormatter.format(post.views)}</span></span>
                  <span class="tag-chip is-orange"><span>评论 {post.comments}</span></span>
                </div>
              </div>
            ))
          }
        </div>
      </article>
    </section>
  </div>
</BaseLayout>

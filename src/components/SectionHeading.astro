---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  serial?: string;
}

const { eyebrow, title, description, serial } = Astro.props;
---

<div class="section-heading">
  <div class="section-heading__top">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    {serial && <span class="section-heading__serial">{serial}</span>}
  </div>
  <h2>{title}</h2>
  {description && <p class="section-description">{description}</p>}
</div>

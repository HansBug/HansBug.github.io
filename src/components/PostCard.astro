---
import type { CollectionEntry } from "astro:content";
import { calculateReadingMinutes, tagToSlug } from "../utils/content";
import { formatDate } from "../utils/date";
import TagChip from "./TagChip.astro";

interface Props {
  post: CollectionEntry<"blog">;
  compact?: boolean;
}

const { post, compact = false } = Astro.props;
const readingMinutes = calculateReadingMinutes(post.body ?? "");
const summary = post.data.excerpt ?? post.data.description;
const cardKicker = post.data.series ?? "TECH NOTE";
const cardStatus = post.data.pinned ? "PINNED" : compact ? "SCAN" : "ENTRY";
const visibleTags = compact ? post.data.tags.slice(0, 3) : post.data.tags;
---

<article class:list={["post-card shell-card", compact && "is-compact", post.data.pinned && "is-pinned"]}>
  <div class="entry-rail">
    <p class="entry-rail__kicker">{cardKicker}</p>
    <span class="entry-rail__status">{cardStatus}</span>
  </div>
  <div class="post-card__meta">
    <span>DATE · {formatDate(post.data.pubDate)}</span>
    <span>LEVEL · {post.data.difficulty}</span>
    <span>READ · {readingMinutes} 分钟</span>
  </div>
  <h3>
    <a href={`/blog/${post.id}/`}>{post.data.title}</a>
  </h3>
  <p>{summary}</p>
  <div class="tag-row">
    {visibleTags.map((tag) => <TagChip tag={tag} href={`/tags/${tagToSlug(tag)}/`} />)}
  </div>
  <p class="entry-footnote">/blog/{post.id}/</p>
</article>

---
import type { CollectionEntry } from "astro:content";
import { tagToSlug } from "../utils/content";
import TagChip from "./TagChip.astro";

interface Props {
  route: CollectionEntry<"routes">;
}

const { route } = Astro.props;
const routeStatus = route.data.recommendedPosts.length > 0 ? "CURATED" : "ROUTE";
---

<article class="route-card shell-card">
  <div class="entry-rail">
    <p class="entry-rail__kicker">READING ROUTE</p>
    <span class="entry-rail__status">{routeStatus}</span>
  </div>
  <div class="route-card__meta">
    <span>STAGE · {route.data.stage}</span>
    <span>TIME · {route.data.estimatedTime}</span>
  </div>
  <h3>
    <a href={`/routes/${route.id}/`}>{route.data.title}</a>
  </h3>
  <p>{route.data.summary}</p>
  <div class="tag-row">
    {route.data.tags.map((tag) => <TagChip tag={tag} href={`/tags/${tagToSlug(tag)}/`} />)}
  </div>
  <p class="entry-footnote">/routes/{route.id}/</p>
</article>

---
import { siteConfig } from "../config/site";
---

<footer class="site-footer">
  <div class="container">
    <div class="shell-card footer-inner">
      <div class="footer-brand">
        <p class="footer-kicker">HB-NODE // SYSTEM FOOTNOTE</p>
        <p class="footer-title">{siteConfig.shortTitle}</p>
        <p class="footer-copy">
          新站只承接后续写作、项目记录和知识索引；旧博客正文继续留在独立归档入口，不伪装成近期内容。
        </p>
      </div>

      <div class="footer-meta">
        <div>
          <span class="footer-meta__label">Publish</span>
          <strong>Astro / GitHub Pages</strong>
        </div>
        <div>
          <span class="footer-meta__label">Contact</span>
          <strong>{siteConfig.email}</strong>
        </div>
        <div>
          <span class="footer-meta__label">Legacy</span>
          <strong>315 篇旧站文章已归档索引</strong>
        </div>
      </div>

      <div class="footer-links">
        <a href={siteConfig.repoUrl} target="_blank" rel="noreferrer">GitHub</a>
        <a href={siteConfig.issueUrl} target="_blank" rel="noreferrer">Issue 反馈</a>
        <a href={siteConfig.discussionsUrl} target="_blank" rel="noreferrer">Discussions</a>
        <a href={siteConfig.oldBlogArchivePath}>旧站归档</a>
        <a href={siteConfig.oldBlogUrl} target="_blank" rel="noreferrer">旧博客园</a>
        <a href={`mailto:${siteConfig.email}`}>邮箱联系</a>
        <a href={siteConfig.rssUrl}>RSS</a>
      </div>
    </div>
  </div>
</footer>
